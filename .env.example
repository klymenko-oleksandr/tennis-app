# Copy to .env and fill in real values. .env is gitignored — never commit it.
# Used by docker-compose.yml (self-hosted Postgres + Supabase Auth / GoTrue, per DR.md §3-4)
# and by Prisma (apps/api) to connect to that same Postgres instance.

# --- Postgres ---
POSTGRES_USER=tennis
POSTGRES_PASSWORD=tennis
POSTGRES_DB=tennis
POSTGRES_PORT=5433

# --- Prisma ---
DATABASE_URL=postgresql://tennis:tennis@localhost:5433/tennis?schema=public
# Used by apps/api's integration tests — a separate DB so tests never touch
# dev data. One-time setup: `docker compose exec db psql -U tennis -d
# postgres -c "CREATE DATABASE tennis_test;"`, then `DATABASE_URL=$DATABASE_URL_TEST
# npx prisma migrate deploy`.
DATABASE_URL_TEST=postgresql://tennis:tennis@localhost:5433/tennis_test?schema=public

# --- GoTrue (Supabase Auth) ---
GOTRUE_PORT=9999
GOTRUE_URL=http://localhost:9999
SITE_URL=http://localhost:4200

# Generate with: openssl rand -base64 32
GOTRUE_JWT_SECRET=

# --- Google OAuth client (Google Cloud Console) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
